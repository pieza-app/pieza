{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": {{nombre|json}},
  "version": "{{version}}",
  "identifier": "{{bundle}}",
  "mainBinaryName": "{{nombre_ascii|minus}}",
  "build": { "frontendDist": "vacio" },
  "app": { "windows": [], "withGlobalTauri": false, "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["iconos/32x32.png", "iconos/128x128.png", "iconos/128x128@2x.png", "iconos/icon.icns", "iconos/icon.ico"],
    "category": "{{#si app.empaquetado.linux_categoria}}{{app.empaquetado.linux_categoria|nombre}}{{#sino}}Utility{{/si}}",
    "copyright": "AGPL-3.0",
    "resources": {
      "../app.json": "recursos/app.json",
      "../acciones.json": "recursos/acciones.json",
      "../bin/": "recursos/bin/",
{{#cada app.empaquetado.carpetas como c}}
      "../{{c|ruta}}/": "recursos/{{c|ruta}}/",
{{/cada}}
      "../ui/": "recursos/ui/"
    },
    "macOS": { "minimumSystemVersion": "13.0" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"], "displayLanguageSelector": false } },
    "linux": { "deb": { "section": "utils" } }
  }
}
